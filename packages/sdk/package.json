{
  "name": "@barista/sdk",
  "version": "0.0.0",
  "description": "Put your app in the Barista menu bar for Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplyyliam/Barista.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/simplyyliam/Barista/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/simplyyliam/Barista/issues"
  },
  "keywords": [
    "barista",
    "windows",
    "menu-bar",
    "menubar",
    "tray",
    "status-item",
    "popover"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "default": "./dist/electron.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/sdk",
    "typecheck": "tsc6 --noEmit"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
