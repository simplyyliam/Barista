{
  "name": "barista",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @barista/bar dev",
    "web:dev": "pnpm --filter @barista/web dev",
    "web:build": "pnpm --filter @barista/web build",
    "gen": "cargo test --workspace export_ -q",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @barista/sdk build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test-client": "pnpm --filter @barista/sdk build && node examples/test-client/src/index.ts",
    "inspect": "pnpm --filter @barista/sdk build && node examples/inspect/src/index.ts",
    "release": "node scripts/release.mjs",
    "updater:keygen": "node scripts/updater-keygen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
